### -------------------------------
### 1. Register a new user
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "user1",
  "password": "passw0rd"
}

###

### -------------------------------
### 2. Login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "user1",
  "password": "passw0rd"
}

###

### -------------------------------
### 3. Get current user info (Me)
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

###

### -------------------------------
### 4. Refresh access token
POST {{baseUrl}}/refresh
Content-Type: application/json

{
  "user_id": "{{userID}}",
  "refresh_token": "{{refreshToken}}"
}

###

### -------------------------------
### 5. Logout
POST {{baseUrl}}/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "session_id": "{{sessionID}}"
}

###

### -------------------------------
### 6. Block user
POST {{baseUrl}}/block/{{userID}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "blocked": true
}

###

### -------------------------------
### 7. Unblock user
POST {{baseUrl}}/block/{{userID}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "blocked": false
}
