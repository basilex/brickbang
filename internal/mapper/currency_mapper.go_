package mapper

import (
    "time"

    "brickbang/storage/dbs"
)

type CurrencyCreateRequest struct {
    Name string `json:"name" validate:"required,min=2,max=100"`
    Code string `json:"code" validate:"required,len=3,uppercase"`
}

type CurrencyUpdateRequest struct {
	ID   string `json:"id" validate:"required,xid"`
    Name string `json:"name" validate:"omitempty,min=2,max=100"`
    Code string `json:"code" validate:"omitempty,len=3,uppercase"`
}

type CurrencyResponse struct {
    ID        string    `json:"id"`
    Name      string    `json:"name"`
    Code      string    `json:"code"`
    CreatedAt time.Time `json:"created_at"`
    UpdatedAt time.Time `json:"updated_at"`
}

func ToCurrencyNewParams(req *CurrencyCreateRequest) *dbs.CurrencyNewParams {
    return &dbs.CurrencyNewParams{
	Name:      req.Name,
	Code:      req.Code,
	CreatedAt: time.Now(),
    }
}

func ToCurrencyUpdateParams(id string, req *CurrencyUpdateRequest) *dbs.CurrencyUpdateByIDParams {
    params := &dbs.CurrencyUpdateByIDParams{
	    ID:        req.ID,
	    Name:      req.Name,
	    Code:      req.Code,
	    UpdatedAt: time.Now(),
    }
    return params
}

func ToCurrencyResponse(row *dbs.Currency) *CurrencyResponse {
    return &CurrencyResponse{
	    ID:        row.ID,
	    Name:      row.Name,
	    Code:      row.Code,
	    CreatedAt: row.CreatedAt,
	    UpdatedAt: row.UpdatedAt,
    }
}

func ToCurrencyResponseList(rows []dbs.Currency) []*CurrencyResponse {
    if len(rows) == 0 {
	    return []*CurrencyResponse{}
    }

    result := make([]*CurrencyResponse, 0, len(rows))
    for _, r := range rows {
	    result = append(result, ToCurrencyResponse(&r))
    }
    return result
}
