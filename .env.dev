#
# Common settings
#
PGX_LOG_LEVEL=debug
#
# Server settings
#
SERVER_ADDRESS=0.0.0.0:8081
SERVER_READ_TIMEOUT=3s
SERVER_WRITE_TIMEOUT=3s
SERVER_GRACEFUL_TIMEOUT=5s
SERVER_MAX_HEADER_BYTES=1048576
SERVER_CHILD_PROCESSES=4
#
# CORS settings
#
CORS_ENABLED=true
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Accept,Authorization,Content-Type,X-API-KEY,X-CSRF-Token
CORS_ALLOW_CREDENTIALS=false
CORS_EXPOSE_HEADERS=*
CORS_MAX_AGE=10m
#
# Postgres settings
#
POSTGRES_DB=brickbang_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=system
POSTGRES_PASSWORD=passw0rd
POSTGRES_MAX_CONNS=100
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFE_TIME=10m
POSTGRES_MAX_CONN_IDLE_TIME=3m
POSTGRES_HEALTH_CHECK_PERIOD=30s
#
# TLS/SSL settings
#
TLS_ENABLED=false
TLS_CERT_FILE=/app/cert/brb.crt
TLS_KEY_FILE=/app/cert/brb.key
#
# Jwt settings
# openssl rand -hex 32
#
JWT_SECRET=951b36db6976c6c5ad981e86d99c0e7ee1ba9e18979270f592e1287cf36bf115
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=24h
#
# eof
#
