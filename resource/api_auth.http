@baseUrl = http://localhost:8081/api/v1/auth
@accessToken = <login token>
@refreshToken = <refresh token>
@userID = <ID пользователя из response register/login>
@sessionID = <session ID из login>

### -------------------------------
### 1. Register a new user
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "user15",
  "password": "passw0rd"
}

###

### -------------------------------
### 2. Login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "user15",
  "password": "passw0rd"
}

###

### -------------------------------
### 3. Get current user info (Me)
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

###

### -------------------------------
### 4. Refresh access token
POST {{baseUrl}}/refresh
Content-Type: application/json

{
  "user_id": "{{userID}}",
  "refresh_token": "{{refreshToken}}"
}

###

### -------------------------------
### 5. Logout
POST {{baseUrl}}/logout
Content-Type: application/json

{
  "session_id": "{{sessionID}}"
}

###

### -------------------------------
### 6. Block user
POST {{baseUrl}}/block/{{userID}}
Content-Type: application/json

{
  "blocked": true
}

###

### -------------------------------
### 7. Unblock user
POST {{baseUrl}}/block/{{userID}}
Content-Type: application/json

{
  "blocked": false
}
